# Ambiente de desenvolvimento local e produção
BETTER_AUTH_SECRET=sua-chave-secreta-com-pelo-menos-32-caracteres-de-alta-entropia
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso Cloud (Recomendado para Vercel)
# Crie gratuitamente em https://turso.tech e pegue a URL e o Token
TURSO_DATABASE_URL=libsql://seu-banco-rosa.turso.io
TURSO_AUTH_TOKEN=seu-token-turso-aqui

# Fallback local (caso não configure Turso no ambiente de dev)
DATABASE_URL=file:sqlite.db
