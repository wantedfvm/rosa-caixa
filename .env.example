# ==============================================================================
# Rosa Network · Controle de Caixa
# Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Autenticação e Segurança (Better Auth)
# Gere uma chave de alta entropia com: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=sua-chave-secreta-com-pelo-menos-32-caracteres-de-alta-entropia
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Produção na Vercel (subdomínio da Rosa Network):
# BETTER_AUTH_URL=https://controle.rosanetwork.cloud
# NEXT_PUBLIC_APP_URL=https://controle.rosanetwork.cloud

# ------------------------------------------------------------------------------
# 2. Banco de Dados Turso Cloud (Recomendado para Vercel / Produção)
# Crie seu banco gratuitamente em: https://turso.tech
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://seu-banco-rosa.turso.io
TURSO_AUTH_TOKEN=seu-token-jwt-do-turso-aqui

# ------------------------------------------------------------------------------
# 3. Fallback para Banco Local (Desenvolvimento Offline)
# Se as variáveis do Turso não forem preenchidas, o sistema usa arquivo local:
# ------------------------------------------------------------------------------
DATABASE_URL=file:sqlite.db
